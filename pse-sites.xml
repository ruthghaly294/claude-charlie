<?xml version="1.0" encoding="UTF-8"?>
<!--
  DECODE — Programmable Search Engine site annotations (bulk import).
  Import: PSE control panel (https://programmablesearchengine.google.com/controlpanel/all)
    → your engine → Setup → "Sites to search" → upload this file.
  "_include" adds each site to the engine. With "Search the entire web" ON,
  these boost the listed domains rather than restricting to them.
-->
